{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:taekwonpage:schema:provenance:1",
  "title": "Conjunto de citas documentales de trabajo",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "citations"],
  "properties": {
    "format_version": { "const": 1 },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:taekwonpage:schema:content_source:1" }
    }
  }
}
