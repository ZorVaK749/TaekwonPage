{
  "name": "@taekwonpage/knowledge-validators",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "validate": "node validate-knowledge.mjs",
