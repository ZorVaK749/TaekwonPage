{
  "openapi": "3.1.0",
  "info": {
    "title": "TaeKwonPage API",
    "version": "0.1.0",
    "description": "Contrato de las rutas de lectura de borradores internos y de la identidad local (C1: JWT local autoemitido, Fase 3). No es una API educativa publicada: las rutas de contenido siguen devolviendo 403 por la política deny-all vigente, incluso con un token válido, y /api/v1/me exige Bearer (401 sin token o con token inválido). Los datos responden a revision pending_human_review sobre PDFs locales citados; ningún campo implica aprobación marcial ni currículo escolar.",
    "contact": { "name": "ZVK Tech", "url": "https://github.com/ZorVaK749/TaekwonPage" }
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "Escucha local por defecto (127.0.0.1). Sin hosting declarado." }
  ],
  "paths": {
    "/api/v1/positions/{id}": {
      "get": {
        "operationId": "getPositionDraft",
        "summary": "Borrador de posición con procedencia",
        "parameters": [{ "$ref": "#/components/parameters/CanonicalId" }],
        "responses": {
          "200": { "description": "Posición en revisión con sus citas; geometría desconocida = null.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Position" } } } },
          "400": { "description": "ID que viola la forma canónica." },
          "403": { "description": "Política deny-all vigente; bloqueo preventivo, no autorización resuelta." },
          "404": { "description": "Borrador inexistente; la ausencia no se rellena con datos de otra ficha." }
        }
      }
    },
    "/api/v1/theory/{id}": {
      "get": {
        "operationId": "getTheoryDraft",
        "summary": "Borrador teórico con procedencia",
        "parameters": [{ "$ref": "#/components/parameters/CanonicalId" }],
        "responses": {
          "200": { "description": "Ficha teórica en revisión con sus citas.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Theory" } } } },
          "400": { "description": "ID que viola la forma canónica." },
          "403": { "description": "Política deny-all vigente; bloqueo preventivo, no autorización resuelta." },
          "404": { "description": "Borrador inexistente; la ausencia no se rellena con datos de otra ficha." }
        }
      }
    },
    "/api/v1/vocabulary/{id}": {
      "get": {
        "operationId": "getVocabularyDraft",
        "summary": "Término de vocabulario con procedencia",
        "parameters": [{ "$ref": "#/components/parameters/CanonicalId" }],
        "responses": {
          "200": { "description": "Término en revisión con traducción observada, aliases y citas.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Vocabulary" } } } },
          "400": { "description": "ID que viola la forma canónica." },
          "403": { "description": "Política deny-all vigente; bloqueo preventivo, no autorización resuelta." },
          "404": { "description": "Borrador inexistente; la ausencia no se rellena con datos de otra ficha." }
        }
      }
    },
    "/api/v1/body-tools/{id}": {
      "get": {
        "operationId": "getBodyToolDraft",
        "summary": "Herramienta corporal con procedencia",
        "parameters": [{ "$ref": "#/components/parameters/CanonicalId" }],
        "responses": {
          "200": { "description": "Herramienta corporal en revisión con sus citas.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BodyTool" } } } },
          "400": { "description": "ID que viola la forma canónica." },
          "403": { "description": "Política deny-all vigente; bloqueo preventivo, no autorización resuelta." },
          "404": { "description": "Borrador inexistente; la ausencia no se rellena con datos de otra ficha." }
        }
      }
    },
    "/api/v1/kicks/{id}": {
      "get": {
        "operationId": "getKickDraft",
        "summary": "Patada con procedencia",
        "parameters": [{ "$ref": "#/components/parameters/CanonicalId" }],
        "responses": {
          "200": { "description": "Patada en revisión con sus citas; sin biomecánica derivada.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Kick" } } } },
          "400": { "description": "ID que viola la forma canónica." },
          "403": { "description": "Política deny-all vigente; bloqueo preventivo, no autorización resuelta." },
          "404": { "description": "Borrador inexistente; la ausencia no se rellena con datos de otra ficha." }
        }
      }
    },
    "/api/v1/combat-types/{id}": {
      "get": {
        "operationId": "getCombatTypeDraft",
        "summary": "Modalidad de combate con procedencia",
        "parameters": [{ "$ref": "#/components/parameters/CanonicalId" }],
        "responses": {
          "200": { "description": "Modalidad de combate observada en revisión con sus citas; ninguna modalidad se selecciona ni aprueba aquí.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CombatType" } } } },
          "400": { "description": "ID que viola la forma canónica." },
          "403": { "description": "Política deny-all vigente; bloqueo preventivo, no autorización resuelta." },
          "404": { "description": "Borrador inexistente; la ausencia no se rellena con datos de otra ficha." }
        }
      }
    },
    "/api/v1/tuls/{id}": {
      "get": {
        "operationId": "getTulDraft",
        "summary": "Tul o ejercicio parcial con procedencia por paso",
        "parameters": [{ "$ref": "#/components/parameters/CanonicalId" }],
        "responses": {
          "200": { "description": "Secuencia en revisión tal como se observó: movementCount y sequenceScope pueden ser null, sequenceComplete puede ser false.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Tul" } } } },
          "400": { "description": "ID que viola la forma canónica." },
          "403": { "description": "Política deny-all vigente; bloqueo preventivo, no autorización resuelta." },
          "404": { "description": "Borrador inexistente; la ausencia no se rellena con datos de otra ficha." }
        }
      }
    },
    "/api/v1/gups/{gup}": {
      "get": {
        "operationId": "getGupCurriculumDraft",
        "summary": "Esquema curricular de un Gup con procedencia",
        "parameters": [{ "$ref": "#/components/parameters/GupNumber" }],
        "responses": {
          "200": { "description": "Gup en revisión con sus siete grupos de requisitos observados y sus citas; un grupo vacío significa «sin vínculos», no requisitos rellenados y no aprobación escolar. La base real sin currículo devuelve 404.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Gup" } } } },
          "400": { "description": "Número de Gup fuera del rango 1–10." },
          "403": { "description": "Política deny-all vigente; bloqueo preventivo, no autorización resuelta." },
          "404": { "description": "Borrador inexistente; la ausencia no se rellena con datos de otra ficha." }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "postLogin",
        "summary": "Intercambio de credenciales por un token local",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": { "description": "Credenciales válidas; token local de corta vida, sin refresh token.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" } } } },
          "400": { "description": "Cuerpo ausente o inválido; username ASCII permitido de 3–64 caracteres, contraseña no vacía de hasta 72 bytes UTF-8 (límite BCrypt)." },
          "401": { "description": "Usuario inexistente, contraseña incorrecta o cuenta deshabilitada; respuesta idéntica en todos los casos para no enumerar cuentas. Cabecera WWW-Authenticate: Bearer." }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getIdentity",
        "summary": "Identidad que transporta el token",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Id, username y roles del token; sin correo, sin grado y sin contenido.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeResponse" } } } },
          "401": { "description": "Sin cabecera Authorization, token ausente, falsificado o expirado. Cabecera WWW-Authenticate: Bearer." }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT HS256 autoemitido por este servidor (C1: JWT local autoemitido). Identifica al usuario; nunca abre rutas de contenido por sí solo."
      }
    },
    "parameters": {
      "CanonicalId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "ID canónico global; la misma forma del dominio SQL canonical_id.",
        "schema": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" }
      },
      "GupNumber": {
        "name": "gup",
        "in": "path",
        "required": true,
        "description": "Número de Gup; el mismo rango del check SQL gup BETWEEN 1 AND 10. El identificador canónico del borrador es gup_<n>.",
        "schema": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "schemas": {
      "CanonicalId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
      "ReviewStatus": { "type": "string", "enum": ["pending_human_review"] },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["username", "password"],
        "description": "Credenciales locales; nunca se registra, nunca se refleja en la respuesta y no se almacena en claro.",
        "properties": {
          "username": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
          "password": { "type": "string", "minLength": 1, "maxLength": 72, "writeOnly": true, "description": "Máximo 72 bytes UTF-8, no solo 72 caracteres; sin truncamiento." }
        }
      },
      "TokenResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["access_token", "token_type", "expires_in"],
        "description": "Token local de corta vida; no hay refresh token y el token no otorga acceso a contenido.",
        "properties": {
          "access_token": { "type": "string" },
          "token_type": { "type": "string", "enum": ["Bearer"] },
          "expires_in": { "type": "integer", "minimum": 1 }
        }
      },
      "MeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "username", "roles"],
        "description": "Eco de identidad: id canónico, username y roles ROLE_*; sin correo, sin grado marcial y sin contenido.",
        "properties": {
          "id": { "$ref": "#/components/schemas/CanonicalId" },
          "username": { "type": "string" },
          "roles": { "type": "array", "items": { "type": "string", "pattern": "^ROLE_[A-Z_]+$" }, "uniqueItems": true }
        }
      },
      "Citation": {
        "type": "object",
        "additionalProperties": false,
        "description": "Metadatos de la copia observada, nunca una ruta a su PDF local.",
        "required": ["id", "sourceId", "sourceSha256", "sourceTitle", "sourceOrganization", "sourceAuthor", "sourceEdition", "sourceLanguage", "pdfPage", "printedPage", "section", "reviewStatus", "sourceReviewStatus", "redistributionStatus"],
        "properties": {
          "id": { "$ref": "#/components/schemas/CanonicalId" },
          "sourceId": { "$ref": "#/components/schemas/CanonicalId" },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sourceTitle": { "type": ["string", "null"] },
          "sourceOrganization": { "type": ["string", "null"] },
          "sourceAuthor": { "type": ["string", "null"] },
          "sourceEdition": { "type": ["string", "null"] },
          "sourceLanguage": { "type": ["string", "null"] },
          "pdfPage": { "type": ["integer", "null"], "minimum": 1 },
          "printedPage": { "type": ["string", "null"] },
          "section": { "type": ["string", "null"] },
          "reviewStatus": { "$ref": "#/components/schemas/ReviewStatus" },
          "sourceReviewStatus": { "$ref": "#/components/schemas/ReviewStatus" },
          "redistributionStatus": { "type": "string", "enum": ["unknown"] }
        }
      },
      "Position": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "reviewStatus", "frontPercent", "rearPercent", "frontRotationDeg", "rearRotationDeg", "citations"],
        "properties": {
          "id": { "$ref": "#/components/schemas/CanonicalId" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "reviewStatus": { "$ref": "#/components/schemas/ReviewStatus" },
          "frontPercent": { "type": ["number", "null"] },
          "rearPercent": { "type": ["number", "null"] },
          "frontRotationDeg": { "type": ["number", "null"] },
          "rearRotationDeg": { "type": ["number", "null"] },
          "citations": { "type": "array", "items": { "$ref": "#/components/schemas/Citation" } }
        }
      },
      "Theory": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "reviewStatus", "citations"],
        "properties": {
          "id": { "$ref": "#/components/schemas/CanonicalId" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "reviewStatus": { "$ref": "#/components/schemas/ReviewStatus" },
          "citations": { "type": "array", "items": { "$ref": "#/components/schemas/Citation" } }
        }
      },
      "BodyTool": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "reviewStatus", "citations"],
        "properties": {
          "id": { "$ref": "#/components/schemas/CanonicalId" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "reviewStatus": { "$ref": "#/components/schemas/ReviewStatus" },
          "citations": { "type": "array", "items": { "$ref": "#/components/schemas/Citation" } }
        }
      },
      "Kick": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "reviewStatus", "citations"],
        "properties": {
          "id": { "$ref": "#/components/schemas/CanonicalId" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "reviewStatus": { "$ref": "#/components/schemas/ReviewStatus" },
          "citations": { "type": "array", "items": { "$ref": "#/components/schemas/Citation" } }
        }
      },
      "CombatType": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "reviewStatus", "citations"],
        "properties": {
          "id": { "$ref": "#/components/schemas/CanonicalId" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "reviewStatus": { "$ref": "#/components/schemas/ReviewStatus" },
          "citations": { "type": "array", "items": { "$ref": "#/components/schemas/Citation" } }
        }
      },
      "Vocabulary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "reviewStatus", "translation", "aliases", "citations"],
        "properties": {
          "id": { "$ref": "#/components/schemas/CanonicalId" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "reviewStatus": { "$ref": "#/components/schemas/ReviewStatus" },
          "translation": { "type": "string", "description": "Traducción observada en el manual, sin armonizar." },
          "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "citations": { "type": "array", "items": { "$ref": "#/components/schemas/Citation" } }
        }
      },
      "TulStep": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepNumber", "positionId", "description", "citationIds"],
        "properties": {
          "stepNumber": { "type": "integer", "minimum": 1 },
          "positionId": { "$ref": "#/components/schemas/CanonicalId" },
          "description": { "type": "string" },
          "citationIds": { "type": "array", "items": { "$ref": "#/components/schemas/CanonicalId" }, "description": "Citas que respaldan el paso; vacío significa evidencia no vinculada, no evidencia inferida." }
        }
      },
      "Tul": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "reviewStatus", "movementCount", "initialPositionId", "sequenceComplete", "sequenceScope", "steps", "citations"],
        "properties": {
          "id": { "$ref": "#/components/schemas/CanonicalId" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "reviewStatus": { "$ref": "#/components/schemas/ReviewStatus" },
          "movementCount": { "type": ["integer", "null"], "minimum": 1, "description": "null = conteo global aún desconocido; no se deduce de los pasos documentados." },
          "initialPositionId": { "anyOf": [{ "$ref": "#/components/schemas/CanonicalId" }, { "type": "null" }] },
          "sequenceComplete": { "type": "boolean", "description": "false en secuencias parciales observadas." },
          "sequenceScope": { "type": ["string", "null"] },
          "steps": { "type": "array", "items": { "$ref": "#/components/schemas/TulStep" } },
          "citations": { "type": "array", "items": { "$ref": "#/components/schemas/Citation" } }
        }
      },
      "GupRequirements": {
        "type": "object",
        "additionalProperties": false,
        "description": "Los siete grupos del esquema curricular observado, tal como están vinculados en el borrador. Vacío = sin vínculos; nunca se rellenan desde otro Gup ni desde los JSON antiguos.",
        "required": ["positionIds", "theoryIds", "vocabularyIds", "bodyToolIds", "kickIds", "tulIds", "combatIds"],
        "properties": {
          "positionIds": { "type": "array", "items": { "$ref": "#/components/schemas/CanonicalId" }, "uniqueItems": true },
          "theoryIds": { "type": "array", "items": { "$ref": "#/components/schemas/CanonicalId" }, "uniqueItems": true },
          "vocabularyIds": { "type": "array", "items": { "$ref": "#/components/schemas/CanonicalId" }, "uniqueItems": true },
          "bodyToolIds": { "type": "array", "items": { "$ref": "#/components/schemas/CanonicalId" }, "uniqueItems": true },
          "kickIds": { "type": "array", "items": { "$ref": "#/components/schemas/CanonicalId" }, "uniqueItems": true },
          "tulIds": { "type": "array", "items": { "$ref": "#/components/schemas/CanonicalId" }, "uniqueItems": true },
          "combatIds": { "type": "array", "items": { "$ref": "#/components/schemas/CanonicalId" }, "uniqueItems": true }
        }
      },
      "Gup": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "gup", "name", "description", "reviewStatus", "requirements", "citations"],
        "properties": {
          "id": { "$ref": "#/components/schemas/CanonicalId" },
          "gup": { "type": "integer", "minimum": 1, "maximum": 10 },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "reviewStatus": { "$ref": "#/components/schemas/ReviewStatus" },
          "requirements": { "$ref": "#/components/schemas/GupRequirements" },
          "citations": { "type": "array", "items": { "$ref": "#/components/schemas/Citation" } }
        }
      }
    }
  }
}
