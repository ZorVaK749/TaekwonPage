# Local only. Copy to .env and supply a unique password before starting Compose.
DB_NAME=taekwonpage
DB_USERNAME=taekwonpage
DB_PASSWORD=
DB_PORT=5432
# C1: local self-issued JWT. Required, at least 32 bytes, never committed.
# Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ISSUER=taekwonpage-local
JWT_TTL_SECONDS=1800
