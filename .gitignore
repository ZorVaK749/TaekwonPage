# Fuentes documentales locales: no redistribuir sin autorización.
/knowledge/sources/pdfs/**
/knowledge/sources/local-previews/
*.[pP][dD][fF]

# Java / Maven (conservar fuentes, pom.xml y Maven Wrapper).
*.class
*.jar
*.war
*.ear
*.nar
target/
.mvn/timing.properties
!**/.mvn/wrapper/maven-wrapper.jar
hs_err_pid*
replay_pid*

# Node / Angular / resultados de tests.
node_modules/
.angular/
dist/
out-tsc/
coverage/
.nyc_output/
.npm/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
test-results/
playwright-report/

# IntelliJ / Eclipse / VS Code: configuración local.
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.factorypath
.vscode/
*.code-workspace

# Variables de entorno y secretos locales (plantillas sin valores reales permitidas).
.env
.env.*
!.env.example
!.env.*.example
*.local.env
*.pem
*.key
*.p12
*.pfx
*.jks

# Docker: overrides y datos locales, no Dockerfiles ni Compose compartidos.
compose.override.yml
compose.override.yaml
docker-compose.override.yml
docker-compose.override.yaml
.docker/
/infrastructure/local/data/
/infrastructure/local/volumes/
/infrastructure/local/backups/

# Logs, temporales y Windows.
*.log
*.tmp
*.temp
*.swp
*~
[Tt]humbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
